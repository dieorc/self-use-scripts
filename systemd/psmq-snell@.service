[Unit]
Description=Quota-managed Snell V5 instance %i
BindsTo=psm-snell-quota.service
After=psm-snell-quota.service network.target
PartOf=psm-snell-quota.service

[Service]
Type=simple
User=snellquota
Group=snellquota
ExecStart=/usr/local/lib/psm-snell-quota/snell-server -c /etc/psm-snell-quota/instances/%i.conf
Restart=no
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LimitNOFILE=65536
# No Install section: controller alone starts instances after installing gates.
